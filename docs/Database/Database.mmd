erDiagram
    users {
        UUID id PK
        VARCHAR username UK
        VARCHAR email UK
        VARCHAR password_hash
        VARCHAR avatar_url
        user_role role
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }

    refresh_tokens {
        UUID id PK
        UUID user_id FK
        VARCHAR token_hash
        TIMESTAMP created_at
        TIMESTAMP expires_at
    }

    generations {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        VARCHAR region_name
    }

    pokemon_species {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        VARCHAR slug UK
        BOOLEAN is_legendary
        BOOLEAN is_mythical
        BOOLEAN is_baby
        INT capture_rate
        INT gender_rate
        INT hatch_counter
        INT base_happiness
        UUID generation_id FK
        TEXT flavor_text
    }

    pokemon {
        UUID id PK
        INT poke_api_id UK
        UUID species_id FK
        VARCHAR form_name
        VARCHAR slug UK
        INT height
        INT weight
        INT base_experience
        BOOLEAN is_default
        BOOLEAN is_mega
        BOOLEAN is_gmax
        TEXT sprite_url
        TEXT shiny_sprite_url
        TEXT official_art_url
    }

    types {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        VARCHAR color
    }

    type_relations {
        UUID attacking_type_id PK,FK
        UUID defending_type_id PK,FK
        REAL multiplier
    }

    stats {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        VARCHAR short_name
    }

    abilities {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        TEXT effect
        TEXT flavor_text
    }

    items {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        VARCHAR slug UK
        item_category category
        TEXT effect
        TEXT flavor_text
        INT cost
        TEXT sprite_url
    }

    moves {
        UUID id PK
        INT poke_api_id UK
        VARCHAR name UK
        INT accuracy
        INT power
        INT pp
        INT priority
        VARCHAR damage_class
        UUID move_type_id FK
        TEXT effect
        TEXT flavor_text
    }

    pokemon_types {
        UUID pokemon_id PK,FK
        UUID type_id PK,FK
        INT slot
    }

    pokemon_stats {
        UUID pokemon_id PK,FK
        UUID stat_id PK,FK
        INT base_value
        INT effort
    }

    pokemon_abilities {
        UUID pokemon_id PK,FK
        UUID ability_id PK,FK
        BOOLEAN is_hidden
        INT slot
    }

    pokemon_moves {
        UUID pokemon_id PK,FK
        UUID move_id PK,FK
        learn_method learn_method PK
        INT version_group_id PK
        SMALLINT level_learned_at
    }

    evolution_chains {
        UUID id PK
        INT poke_api_id UK
    }

    evolution_chain_nodes {
        UUID id PK
        UUID chain_id FK
        UUID species_id FK
        UUID parent_node_id FK
        evolution_trigger trigger
        SMALLINT min_level
        UUID item_id FK
        UUID held_item_id FK
        SMALLINT min_happiness
        SMALLINT min_affection
        SMALLINT min_beauty
        VARCHAR time_of_day
        UUID known_move_id FK
        VARCHAR known_move_type
        UUID party_species_id FK
        VARCHAR party_type_required
        SMALLINT relative_physical_stats
        VARCHAR gender_required
        VARCHAR location_required
        BOOLEAN needs_rain
        BOOLEAN turn_upside_down
        BOOLEAN is_night_shade
    }

    users ||--o{ refresh_tokens : owns
    generations ||--o{ pokemon_species : contains
    pokemon_species ||--o{ pokemon : has_forms

    pokemon ||--o{ pokemon_types : has
    types ||--o{ pokemon_types : classifies

    pokemon ||--o{ pokemon_stats : has
    stats ||--o{ pokemon_stats : measures

    pokemon ||--o{ pokemon_abilities : has
    abilities ||--o{ pokemon_abilities : assigns

    pokemon ||--o{ pokemon_moves : learns
    moves ||--o{ pokemon_moves : learned_by
    types ||--o{ moves : move_type

    types ||--o{ type_relations : attacks_as
    types ||--o{ type_relations : defends_as

    evolution_chains ||--o{ evolution_chain_nodes : contains
    pokemon_species ||--o{ evolution_chain_nodes : represents
    evolution_chain_nodes ||--o{ evolution_chain_nodes : parent_of
    items ||--o{ evolution_chain_nodes : use_item
    items ||--o{ evolution_chain_nodes : held_item
    moves ||--o{ evolution_chain_nodes : known_move
    pokemon_species ||--o{ evolution_chain_nodes : party_species
